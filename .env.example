# 값 자체는 커밋하지 말고, 실행 환경의 비밀 변수로 설정하세요.
MINIGAME_PASSWORD=replace-with-a-long-unique-password

# 선택: 별도 서명 키를 쓸 때 설정합니다. 같은 값을 유지하면 서버 재시작 뒤에도 쿠키가 유지됩니다.
# 미설정 시 비밀번호에서 키를 만들므로 같은 비밀번호로 재시작해도 쿠키가 유지됩니다.
MINIGAME_SESSION_SECRET=replace-with-an-independent-random-secret

# HTTPS 리버스 프록시를 사용할 때만 1로 설정합니다.
MINIGAME_COOKIE_SECURE=1

# 로비의 친구 초대 패널에 표시할 외부 HTTPS 주소입니다.
MINIGAME_PUBLIC_URL=https://203.0.113.10
